{
  "name": "dsh-annotate-sidechat",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "Select text in an assistant reply and send the located quote to the main composer or to a side chat created on send.",
  "license": "MIT",
  "author": "baicaihenxiao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baicaihenxiao/dsh-annotate-sidechat.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.0-rc.2 || 0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "meta": {
    "title": "Quote → side chat",
    "description": "Select assistant reply text, then send the located quote to the main composer or to a side chat that is created when you send it."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
